# Local demo only. ShiftRelay refuses to start with a non-demo project or non-local host.
VITE_FIREBASE_PROJECT_ID=demo-shiftrelay
VITE_EMULATOR_HOST=127.0.0.1

# Live modes never read this file. `npm run dev:live-local` reads the outside-root private
# configuration instead (see docs/INTERFACES.md §11), and a hosted build only embeds the public
# App Check site key: VITE_FIREBASE_APPCHECK_SITE_KEY. Never put a real key, debug token or password
# here: `.env.*` is ignored, but the credential scan covers the whole working tree.
